      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n    w.WorkerName AS AuthorFIO,\n    COUNT(*) AS UnsignedCount\nFROM [dbo].[MedicalDocument] md\nJOIN [dbo].[Worker] w ON md.AuthorID_Ref = w.WorkerID\nWHERE md.MedicalDocumentStatusID_Ref = 2\n  AND md.MedicalDocumentDate >= '{{ $now.minus({days: 1}).toFormat(\"yyyyMMdd\") }}'\n  AND md.MedicalDocumentDate <  '{{ $now.toFormat(\"yyyyMMdd\") }}'\nGROUP BY w.WorkerName\nORDER BY UnsignedCount DESC;",
        "options": {}
