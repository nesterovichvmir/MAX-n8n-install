      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n    w.WorkerName AS AuthorFIO,\n    COUNT(*) AS UnsignedCount\nFROM [dbo].[MedicalDocument] md\nJOIN [dbo].[Worker] w ON md.AuthorID_Ref = w.WorkerID\nWHERE md.MedicalDocumentStatusID_Ref = 2\n  AND md.MedicalDocumentDate >= '{{ $now.toFormat(\"yyyyMMdd\") }}'\n  AND md.MedicalDocumentDate <  '{{ $now.plus({days: 1}).toFormat(\"yyyyMMdd\") }}'\nGROUP BY w.WorkerName\nORDER BY UnsignedCount DESC;",
        "options": {}
      },
      "type": "n8n-nodes-base.microsoftSql",
      "typeVersion": 1.2,
      "position": [
        -32,
        -48
