    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const video = item.json.attachment.video;\n\n  return {\n    json: {\n      text: item.json.text,\n      video_page: `https://vk.com/video${video.owner_id}_${video.id}`,\n      video_id: video.id,\n      owner_id: video.owner_id\n    }\n  };\n});"
      },
