    {
      "parameters": {
        "jsCode": "// Берем все элементы, пришедшие из VK\nconst items = $input.all();\nconst result = [];\n\nfor (const item of items) {\n  const data = item.json;\n  // Проверяем, есть ли вложения\n  if (data.object && data.object.attachments && data.object.attachments.length > 0) {\n    // Проходимся по каждому вложению\n    for (const attachment of data.object.attachments) {\n      // Создаем новый объект: копируем текст и добавляем текущее вложение\n      result.push({\n        json: {\n          text: data.object.text, // Сохраняем текст поста\n          type: attachment.type,  // Тип (photo/video)\n          attachment: attachment // Само вложение (ссылки на фото/видео)\n        }\n      });\n    }\n  } else {\n    // Если вложений нет, просто передаем текст\n    result.push({\n      json: {\n        text: data.object.text,\n        type: 'text',\n        attachment: null\n      }\n    });\n  }\n}\n\nreturn result;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -816,
        -320
      ],
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "\n// Получаем все элементы после загрузки фотографий\nconst items = $input.all();\nconst attachments = [];\n\nfor (const item of items) {\n  const photos = item.json.photos;\n\n  // photos может быть массивом или объектом с ключами \"0\", \"1\" и т. д.\n  const photoList = Array.isArray(photos)\n    ? photos\n    : photos && typeof photos === 'object'\n      ? Object.values(photos)\n      : [];\n\n  // Добавляем все найденные фотографии\n  for (const photo of photoList) {\n    if (photo?.token) {\n      attachments.push({\n        type: 'image',\n        payload: { token: photo.token }\n      });\n    }\n  }\n\n  // Проверяем токен видео\n  if (item.json.token) {\n    attachments.push({\n      type: 'video',\n      payload: { token: item.json.token }\n    });\n  }\n}\n\n// Получаем исходный текст публикации VK\nconst originalText =\n  $('VK Community Trigger').item.json.object.text || '';\n\n// Формируем одно сообщение со всеми вложениями\nreturn [{\n  json: {\n    text: originalText,\n    attachments\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
