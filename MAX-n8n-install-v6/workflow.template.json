    {
      "parameters": {
        "jsCode": "// Берем данные из Merge (результаты SQL)\nconst sqlRows = $input.all();\n\n// Получаем список всех получателей из таблицы (через узел Get row(s))\nlet allRecipients = [];\ntry {\n  allRecipients = $('Get row(s)').all();\n} catch (e) {\n  allRecipients = []; \n}\n\nconst messages = [];\n\n// --- БЛОК ОПРЕДЕЛЕНИЯ ВРЕМЕНИ (ВЧЕРА/СЕГОДНЯ) ---\nlet reportType = \"\";\n\nconst now = new Date();\nconst moscowTime = new Date(now.getTime() + (3 * 60 * 60 * 1000));\nconst currentHour = moscowTime.getUTCHours();\n\nif (currentHour < 12) {\n    reportType = \"за вчерашний день\";\n} else {\n    reportType = \"за текущий день\";\n}\n// ------------------------------------------------\n\n// Формируем сообщения\nfor (const item of sqlRows) {\n  const sqlData = item.json;\n  if (!sqlData || !sqlData.AuthorFIO) continue; // Пропускаем пустые строки\n\n  // Ищем врача в таблице получателей\n  const match = allRecipients.find(r => r.json.fio === sqlData.AuthorFIO);\n  \n  // Если нашли и у него есть ID в MAX\n  if (match && match.json.max_user_id) {\n    messages.push({\n      json: {\n        user_id: String(match.json.max_user_id),\n        text: `📋 ${sqlData.AuthorFIO}, у вас ${sqlData.UnsignedCount} неподписанных СЭМД (${reportType}). Пожалуйста, подпишите их.`\n      }\n    });\n  }\n}\n\nreturn messages;"
      },
