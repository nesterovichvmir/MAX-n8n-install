    {
      "parameters": {
        "jsCode": "// Берем все данные, которые пришли из Merge\nconst allData = $input.all();\n\n// Определяем время по Москве (UTC+3)\nconst now = new Date();\nconst moscowTime = new Date(now.getTime() + (3 * 60 * 60 * 1000));\nconst currentHour = moscowTime.getUTCHours();\n\nlet reportType = \"\";\n\n// Если до 12 часов — это утренний отчет (за вчера)\nif (currentHour < 12) {\n    reportType = \"за вчерашний день\";\n} \n// Если после 12 — дневной (за сегодня)\nelse {\n    reportType = \"за текущий день\";\n}\n\n// Формируем текстовый список\nlet tableText = `📊 *Сводка по неподписанным СЭМД (${reportType})*\\n\\n`;\n\nfor (const item of allData) {\n    const fio = item.json.AuthorFIO;\n    const count = item.json.UnsignedCount;\n    tableText += `👤 ${fio} — *${count}* шт.\\n`;\n}\n\ntableText += \"\\n_Пожалуйста, подпишите документы._\";\n\nreturn [{ json: { tableText: tableText } }];"
      },
